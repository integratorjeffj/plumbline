# Copy this file to .env and fill in real values. .env is git-ignored.

# Required only for a live run (omit --fake) of scripts/run_comparison.py or
# scripts/run_slice.py. Without this set, both fall back to FakeProvider and
# run fully offline against recorded responses.
ANTHROPIC_API_KEY=

# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-5
# DB_PATH=./bid_intel.db
