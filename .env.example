# Copy this file to .env and fill in real values. .env is git-ignored.

# Required only for a live run: scripts/run_comparison.py, scripts/run_slice.py,
# or the evaluation harness with `python eval/run_eval.py --live`. Without this
# set, all three fall back to FakeProvider and run fully offline against
# recorded responses, which costs nothing.
ANTHROPIC_API_KEY=

# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-5
# DB_PATH=./bid_intel.db
