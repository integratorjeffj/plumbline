{
  "name": "plumbline-console",
  "version": "1.0.0",
  "private": true,
  "description": "Review console for Plumbline: side-by-side bid review, leveling, and scope weighting.",
  "scripts": {
    "sync": "node scripts/sync-data.mjs",
    "dev": "node scripts/sync-data.mjs && next dev -p 3210",
    "build": "node scripts/sync-data.mjs && next build && node scripts/publish.mjs",
    "build:demo-projects": "tsx scripts/build-demo-projects.ts",
    "lint": "next lint"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.1.1",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
